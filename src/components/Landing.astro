---
const repo = "https://github.com/nocosheet/nocosheet";

const items = [
  { id: "grid", fx: "35%", label: "Grid", title: "A spreadsheet you can build on.", body: "Browse and edit records in a fast, familiar grid.", alt: "The record grid showing a table of tasks" },
  { id: "schema", fx: "62%", label: "Data modeling", title: "Model your data without code.", body: "Create tables and fields from the UI with a guided wizard. Schema changes apply live.", alt: "A table's fields and their types" },
  { id: "table-new", fx: "58%", label: "New table", title: "Start a table in seconds.", body: "Name it, group it and pick how records are identified, then define its columns.", alt: "The new table form" },
  { id: "view-new", fx: "50%", label: "Views", title: "Save a view of your data.", body: "Pick the columns to show and the filters records must match, then share it as its own grid.", alt: "The create a view dialog" },
  { id: "record", fx: "100%", label: "Fields", title: "Fields that fit your data.", body: "Select and multi-select, dates, currency, attachments and computed fields.", alt: "A record open for editing" },
  { id: "assets", fx: "30%", label: "Files", title: "Files, right on the record.", body: "Attach and manage files on any record, and see them in the grid.", alt: "A table of brand assets with file previews" },
  { id: "roles", fx: "62%", label: "Access", title: "Decide who can do what.", body: "Dynamic roles with workspace and per-table grants, own or all record scopes, and an admin above all.", alt: "Workspace roles and permissions" },
  { id: "trash", fx: "58%", label: "Trash", title: "Deleted by mistake? Restore it.", body: "Deleted tables and views stay in the trash for 30 days before they are gone for good.", alt: "Deleted tables in the trash with restore actions" },
  { id: "home", fx: "56%", label: "Workspace", title: "Everything in one workspace.", body: "Invite members, pin your favorite tables and pick up where you left off.", alt: "The workspace home" },
  { id: "account", fx: "50%", label: "Account", title: "Secure by default.", body: "Sign in with a password or passkey, add an authenticator app and manage your sessions.", alt: "Account security settings" },
];

const headline = "A no-code database that feels like a spreadsheet.".split(" ");

const stack = [
  ["Workers", "Runs the app"],
  ["D1", "Stores your tables and records"],
  ["R2", "Stores your files"],
];
---

<section class="journey" id="top" style={`--n:${items.length}`}>
  <div class="pin">
    <div class="copy">
      <h1 aria-label={headline.join(" ")}>{headline.map((w, i) => <span class="w" aria-hidden="true" style={`--i:${i}`}>{w}</span>)}</h1>
      <p>Model your data, manage records and control who can see what. Open source, on your own Cloudflare account.</p>
      <div class="actions">
        <a class="btn btn-primary" href={repo} rel="noopener">Get started</a>
        <a class="btn" href="#tour" data-tour>Take a tour</a>
      </div>
    </div>

    <div class="captions">
      {items.map((c, i) => (
        <header class="caption" data-i={i}>
          <span class="eyebrow">{c.label}</span>
          <h2>{c.title}</h2>
          <p>{c.body}</p>
        </header>
      ))}
    </div>

    <div class="stage">
      <div class="frame">
        {items.map((c, i) => (
          <div class="layer" data-i={i} style={`--fx:${c.fx};z-index:${i}`}>
            <img class="light" src={`/screenshots/${c.id}-light.webp`} alt={c.alt} width="2880" height="1620" draggable="false" />
            <img class="dark" src={`/screenshots/${c.id}-dark.webp`} alt="" width="2880" height="1620" loading="lazy" draggable="false" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<nav class="rail" aria-label="Tour">
  {items.map((c, i) => (
    <a href="#tour" data-go={i} aria-label={c.title}><i></i></a>
  ))}
</nav>

<section class="close" id="self-host">
  <div class="inner reveal">
    <h2>Your data stays on your account.</h2>
    <p>nocosheet runs entirely on Cloudflare. No external services, nothing else to host.</p>
    <ul>
      {stack.map(([name, note]) => (
        <li><strong>{name}</strong><span>{note}</span></li>
      ))}
    </ul>
    <div class="actions">
      <a class="btn btn-primary" href={repo} rel="noopener">Get started</a>
      <a class="btn" href={repo} rel="noopener">View on GitHub</a>
    </div>
  </div>
  <footer>
    <span>© {new Date().getFullYear()} nocosheet. Open source.</span>
    <a href={repo} rel="noopener">GitHub</a>
  </footer>
</section>

<script>
  const journey = document.querySelector<HTMLElement>(".journey")!;
  const captions = [...document.querySelectorAll<HTMLElement>(".caption")];
  const layers = [...document.querySelectorAll<HTMLElement>(".layer")];
  const rail = document.querySelector<HTMLElement>(".rail")!;
  const railLinks = [...rail.querySelectorAll<HTMLAnchorElement>("a")];
  const n = captions.length;
  const HERO = 1.6;
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const coarse = matchMedia("(pointer: coarse)").matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const smooth = (t: number) => t * t * (3 - 2 * t);

  let target = 0;
  let value = 0;
  let raf = 0;
  let last = 0;
  let active = -1;

  const journeyTop = () => journey.getBoundingClientRect().top + scrollY;

  function measure() {
    target = Math.max(0, (scrollY - journeyTop()) / innerHeight);
  }

  function paint() {
    const t = clamp(value / HERO);
    const u = value - HERO;
    journey.style.setProperty("--t", t.toFixed(4));
    journey.style.setProperty("--k", ease(clamp(t / 0.85)).toFixed(4));

    let best = 0;
    let bestAbs = Infinity;
    for (let j = 0; j < n; j++) {
      const d = u - j;
      const ad = Math.min(Math.abs(d), 1);
      const cap = captions[j];
      cap.style.setProperty("--d", clamp(d, -1, 1).toFixed(4));
      cap.style.setProperty("--ad", ad.toFixed(4));
      cap.setAttribute("aria-hidden", ad < 0.4 ? "false" : "true");

      const layer = layers[j];
      let o: number;
      if (j === 0) o = d < 0.75 ? 1 : 0;
      else if (d < 0) o = smooth(clamp((d + 0.75) / 0.5));
      else o = d < 0.75 || j === n - 1 ? 1 : 0;
      layer.style.setProperty("--o", o.toFixed(3));
      layer.style.setProperty("--sc", (1 + (1 - Math.min(o, 1)) * 0.05).toFixed(4));
      layer.style.visibility = o > 0 ? "visible" : "hidden";

      if (Math.abs(d) < bestAbs) {
        bestAbs = Math.abs(d);
        best = j;
      }
    }
    rail.classList.toggle("show", t > 0.8 && u < n - 1 + 0.6);
    if (best !== active) {
      active = best;
      railLinks.forEach((a, i) => a.classList.toggle("on", i === best));
    }
  }

  function tick(now: number) {
    raf = 0;
    const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
    last = now;
    measure();
    const f = reduced ? 1 : 1 - Math.exp(-dt / 0.085);
    const diff = target - value;
    let moving = false;
    if (Math.abs(diff) < 0.0004) value = target;
    else {
      value += diff * f;
      moving = true;
    }
    paint();
    if (moving) raf = requestAnimationFrame(tick);
  }

  function request() {
    if (!raf) {
      last = performance.now();
      raf = requestAnimationFrame(tick);
    }
  }

  const goTo = (j: number) =>
    scrollTo({ top: journeyTop() + (HERO + j) * innerHeight, behavior: "smooth" });

  let snapTimer = 0;
  function snap() {
    if (coarse || reduced) return;
    const u = target - HERO;
    if (u < -0.3 || u > n - 1 + 0.3) return;
    const nearest = clamp(Math.round(u), 0, n - 1);
    if (Math.abs(u - nearest) < 0.015) return;
    goTo(nearest);
  }

  function onScroll() {
    request();
    clearTimeout(snapTimer);
    snapTimer = window.setTimeout(snap, 170);
  }

  addEventListener("scroll", onScroll, { passive: true });
  addEventListener("resize", request);

  railLinks.forEach((a, i) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      goTo(i);
    }),
  );
  document.querySelector("[data-tour]")?.addEventListener("click", (e) => {
    e.preventDefault();
    goTo(0);
  });

  measure();
  value = target;
  paint();

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) e.target.classList.add("in");
    },
    { threshold: 0.25 },
  );
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

  requestAnimationFrame(() => document.documentElement.classList.add("ready"));
</script>

<style>
  .journey {
    --t: 0;
    --k: 0;
    height: calc((var(--n) + 1.6) * 100vh);
  }
  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .copy {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 3;
    padding: clamp(6rem, 15vh, 10rem) 2rem 0;
    text-align: center;
    opacity: max(0, calc(1 - var(--t) * 2.6));
    transform: translate3d(0, calc(var(--t) * -12vh), 0) scale(calc(1 - var(--t) * 0.1));
    transform-origin: 50% 0;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .copy .actions {
    pointer-events: auto;
  }
  h1 {
    max-width: 16ch;
    margin-inline: auto;
    font-size: clamp(2.5rem, 6vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    font-weight: 650;
    text-wrap: balance;
  }
  .w {
    display: inline-block;
    margin-right: 0.24em;
    animation: word 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.1s + var(--i) * 0.07s);
  }
  @keyframes word {
    from {
      opacity: 0;
      transform: translateY(0.45em);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  .copy p,
  .copy .actions {
    animation: fade 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.7s both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .copy p {
    max-width: 34rem;
    margin: 1.5rem auto 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }
  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .captions {
    position: absolute;
    inset: 4.75rem 0 auto 0;
    z-index: 2;
    display: grid;
    justify-items: center;
    pointer-events: none;
  }
  .caption {
    --d: 0;
    --ad: 1;
    grid-area: 1 / 1;
    max-width: 44rem;
    padding-inline: 1.5rem;
    text-align: center;
    opacity: clamp(0, calc(1.5 - var(--ad) * 3.4), 1);
    filter: blur(calc(var(--ad) * 7px));
    transform: translate3d(0, calc(var(--d) * -7vh), 0);
    will-change: transform, opacity, filter;
  }
  .eyebrow {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
  }
  .caption h2 {
    font-size: clamp(1.75rem, 3vw, 2.625rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 650;
    text-wrap: balance;
  }
  .caption p {
    margin-top: 0.7rem;
    font-size: clamp(1rem, 1.2vw, 1.0625rem);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }

  .stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 14rem 0 1.5rem;
    perspective: 1800px;
  }
  .frame {
    position: relative;
    width: min(100% - 4rem, calc((100dvh - 15.5rem) * 16 / 9));
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border-strong);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    transform-origin: 50% 0;
    transform: translate3d(0, calc((1 - var(--k)) * 46vh), 0) rotateX(calc((1 - var(--k)) * 28deg)) scale(calc(0.78 + var(--k) * 0.22));
    will-change: transform;
    animation: rise 1.8s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both;
  }
  @keyframes rise {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .layer {
    --o: 1;
    --sc: 1;
    position: absolute;
    inset: 0;
    opacity: var(--o);
    background: var(--bg);
  }
  .layer img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    transform: scale(var(--sc));
    will-change: transform;
  }
  .dark {
    display: none;
  }
  :global(:root[data-theme="dark"]) .light {
    display: none;
  }
  :global(:root[data-theme="dark"]) .dark {
    display: block;
  }
  :global(:root[data-theme="dark"]) .frame {
    box-shadow: none;
  }

  .rail {
    position: fixed;
    top: 50%;
    right: 1.25rem;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    transform: translateY(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s;
  }
  .rail.show {
    opacity: 1;
    pointer-events: auto;
  }
  .rail a {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
  }
  .rail i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--border-strong);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s;
  }
  .rail a:hover i {
    background: var(--muted);
  }
  .rail a.on i {
    background: var(--fg);
    transform: scale(1.6);
  }

  .close {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .close .inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6rem 1.5rem 3rem;
    text-align: center;
  }
  .close h2 {
    max-width: 18ch;
    font-size: clamp(2rem, 4.8vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 650;
    text-wrap: balance;
  }
  .close .inner > p {
    max-width: 30rem;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--muted);
    text-wrap: balance;
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 3rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 12.5rem;
    padding: 1.1rem 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: left;
  }
  li strong {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.9375rem;
  }
  li span {
    font-size: 0.875rem;
    color: var(--muted);
  }
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 2rem;
    height: 4.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted);
  }
  footer a:hover {
    color: var(--fg);
  }

  .reveal {
    opacity: 0;
    transform: translateY(2rem);
    transition:
      opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 48rem) {
    .captions {
      inset: 4.25rem 0 auto 0;
    }
    .stage {
      padding: 15rem 0 1rem;
    }
    .frame {
      width: calc(100% - 1.5rem);
      aspect-ratio: 3 / 4;
      max-height: calc(100dvh - 16.5rem);
      border-radius: 0.75rem;
      transform: translate3d(0, calc((1 - var(--k)) * 40vh), 0) rotateX(calc((1 - var(--k)) * 20deg)) scale(calc(0.82 + var(--k) * 0.18));
    }
    .layer img {
      object-position: var(--fx, 35%) top;
    }
    .rail {
      display: none;
    }
    footer {
      padding-inline: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .frame,
    .w,
    .copy p,
    .copy .actions {
      animation: none;
    }
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
